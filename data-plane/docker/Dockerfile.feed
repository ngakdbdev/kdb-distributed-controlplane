# Dockerfile.feed - runs a synthetic feed simulator (bpipe_sim.py / crims_sim.py)
FROM python:3.12-slim

WORKDIR /app
COPY feeds/requirements.txt /app/requirements.txt
COPY feeds/providers/requirements.txt /app/providers-requirements.txt
RUN pip install --no-cache-dir -r requirements.txt -r providers-requirements.txt

COPY feeds/ /app/

ENTRYPOINT ["python3"]
CMD ["bpipe_sim.py"]
