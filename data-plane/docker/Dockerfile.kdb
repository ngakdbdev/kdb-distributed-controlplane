# Dockerfile.kdb - runs any q process in the tick chain (tp/wdb/rdb/idb/gateway)
#
# KX binaries are NOT baked into the image, and NOT staged locally either -
# the entrypoint (docker/kdb-entrypoint.sh) pulls the right arch's binary from
# the KX portal at container start, authenticated with KX_BEARER_TOKEN, and
# caches it in a container-local writable dir purely so a restart doesn't
# re-download. There is no "unzip a downloaded binary into a folder on this
# machine" step anymore - that model only worked on whichever one box a human
# had done it on by hand, and left every other target (a fresh clone, a fresh
# VM, a real cloud deploy) with nothing to find.
#
# You still need a real KX_BEARER_TOKEN (from the KX Developer Portal,
# https://portal.dl.kx.com) and a real license (KDB_LICENSE_B64 inline, or
# KX_LICENSE_PATH pointing at a file mounted some other way - a Kubernetes
# Secret, a secrets-manager sidecar) - see kdb-entrypoint.sh's own docstring.
# KX's terms don't allow bundling or redistributing the binary or a licence,
# so this repo still can't ship either for you; it just no longer expects you
# to have manually placed them anywhere before the container starts.

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl rlwrap procps unzip numactl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY q/ /app/
COPY docker/kdb-entrypoint.sh /usr/local/bin/kdb-entrypoint.sh
RUN chmod +x /usr/local/bin/kdb-entrypoint.sh

# the entrypoint resolves the arch, pulls the binary from the KX portal,
# sets QHOME/QLIC, and execs the right q; each service passes its own script
# + flags as CMD via docker-compose.
ENTRYPOINT ["/usr/local/bin/kdb-entrypoint.sh"]
CMD ["tick.q"]
