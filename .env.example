# Copy this file to .env and fill in real values before deploying anywhere
# beyond your own laptop. Nothing in this file should ever be committed
# with real secrets in it.

ADMIN_USER=admin
# Generate with: python3 -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
# Leave blank to fall back to the built-in default (password: changeme) - fine
# for a local demo, NOT fine for anything reachable from the internet.
ADMIN_PASSWORD_HASH=

JWT_SECRET=change-me-to-a-random-64-char-string
WATCHDOG_SHARED_SECRET=change-me-to-a-different-random-string

# Required ONLY if you use the credentials-only cloud auto-provisioning
# endpoints (POST /cloud-provision/{aws,azure,gcp} - see
# control-api/app/cloud_provisioner.py). Encrypts the AWS/Azure/GCP account
# credentials those endpoints accept before storing them - deliberately has
# NO insecure default (unlike JWT_SECRET above), since a leaked value here
# is a direct path into a real cloud account, not a forgeable session
# token. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLOUD_CREDENTIALS_ENCRYPTION_KEY=

# --- Product licensing (control-api/app/licensing.py) ---
# "local" (default) - your own laptop/dev box. No licence key required;
# control-api logs the licence status but never refuses to start.
# "customer" - a real deployment for a customer. A valid, unexpired
# LICENSE_KEY becomes MANDATORY - control-api refuses to start without one.
# The cloud VM deploy scripts (deploy/aws|gcp|azure) set this to "customer"
# automatically when they generate a fresh .env; the Helm chart (the pilot/
# production path) defaults to "customer" too. Set DEPLOYMENT_ENV=local
# explicitly if you deliberately want a non-laptop box unenforced (e.g. a
# throwaway internal test box that isn't a real customer).
DEPLOYMENT_ENV=local
# 32-character key minted with control-api/app/licensing.py's mint()/
# mint_trial() - see docs/deployment-process.md for how to generate one.
LICENSE_KEY=
# Explicit override, either direction - always wins over the DEPLOYMENT_ENV-
# derived default above when set to true/false. Leave blank to use the
# DEPLOYMENT_ENV default.
LICENSE_ENFORCE=

# --- Compose profile toggles (docker-compose.yml, generated by
# scripts/gen_topology.py - see that file's own comments on each profile) ---
# Docker Compose reads COMPOSE_PROFILES from .env automatically, same as any
# other var here. "llm" turns on the ollama service (~2.4GB RAM held
# permanently - see the ollama block's comment) that powers the query
# workspace's natural-language-to-q box; on by default so a documented
# `cp .env.example .env` deploy still gets it with zero extra steps.
# deploy/*/04_deploy_stack.sh clears this automatically (see
# deploy/lib/free_tier.sh) when it detects a free-tier-class box that can't
# spare the RAM - set it yourself (COMPOSE_PROFILES=) for the same effect on
# a box you sized manually. "postgres" and "providers" (real market-data
# connectors, config/routers/feedhandlers.py's C++ engine) stay opt-in even
# here - add them to this comma-separated list only if you're using them,
# e.g. COMPOSE_PROFILES=llm,postgres.
COMPOSE_PROFILES=llm

# ticks/sec and records/sec the feed simulators generate when enabled
BPIPE_RATE_HZ=500
CRIMS_RATE_HZ=2

# --- KX (KDB-X) install: pulling the q binary + licence ---------------------
# Non-secret defaults for the portal download flow (fleet_agent/kx_installer.py):
# Docker precedence: the kdb containers use a binary already staged in the data
# folder (KX_BINARIES_DIR) if present; otherwise, when KX_INSTALL_SOURCE=kx-portal
# and KX_BEARER_TOKEN is set, they pull <arch>.zip from the KX portal into a cache.
# So attached binaries always win; the portal is the fallback.
KX_INSTALL_SOURCE=kx-portal      # kx-portal | local | url
KX_VERSION=4.1
KX_CHANNEL=~latest~
# Leave empty to auto-detect Linux container architecture (l64/l64arm).
KX_ARCH=
KX_INSTALL_DIR=/opt/kx
# 'local' source / docker: host folder of KX binaries (QHOME layout with
# per-arch subdirs l64/, l64arm/ + kc.lic). Mounted read-only into the kdb
# containers; the container picks the binary for its platform at start.
KX_BINARIES_DIR=./data-plane/docker/kdbx
SIM_SYMBOL_COUNT=1000
PROVIDER_SYMBOLS_FILE=/symbols/universe.txt
# Also read by control-api itself now (app/news_feed.py, the Predictive
# Signals page's news feed) - the same key, a separate per-minute rate
# budget from the finnhub-feed market-data container's own usage.
FINNHUB_API_KEY=d9ovvl9r01qh40a78g7gd9ovvl9r01qh40a78g80

TWELVEDATA_API_KEY=92524bd2f42f4404bda3eaa423b7e923
TWELVEDATA_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA

# Alpha Vantage NEWS_SENTIMENT (optional, separate from the alphavantage-feed
# market-data provider's own key above) - real per-article NLP sentiment
# scores for control-api/app/news_feed.py, when set. Free tier is heavily
# request-limited (historically ~25/day) - blank is fine, the news feed
# just runs on Finnhub's own keyword-based sentiment heuristic instead.
ALPHAVANTAGE_API_KEY=

# --- Alpaca (market data + order routing - control-api/app/alpaca_broker.py) ---
# A free Alpaca account has both an API key ID and a secret key; the same
# pair is used for market data (alpaca-feed, opt-in like the other live
# providers above) AND order routing below. Leave both blank to use neither -
# the bot/order ticket keep using the internal simulated paper fill exactly
# as before this existed.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Comma-separated list. Keep this a small, bounded/curated set (a few dozen
# symbols) - the free/IEX stream has a real, undocumented cap on
# simultaneously-subscribed symbols. Confirmed live: 68 symbols was
# rejected outright ({"T":"error","code":405,"msg":"symbol limit exceeded"});
# 30 was accepted and real trade data flowed within seconds. Do NOT set
# this to "all" (providers/alpaca.py's fetch_all_symbols() exists and CAN
# resolve Alpaca's full several-thousand-symbol universe, same as the
# crypto providers' own --symbols all, but Alpaca's free stream rejects a
# subscribe list anywhere near that size) - see providers/alpaca.py's own
# module docstring for the full story, including why this failure mode is
# easy to miss (auth succeeds, "subscribed" logs cleanly, and the
# rejection is a separate message that arrives right after).
ALPACA_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA
ALPACA_DATA_FEED=iex

# Order routing mode: off (default) | paper | live.
#   off   - unchanged behavior: orders fill against the internal simulator.
#   paper - orders route through Alpaca's OWN paper-trading simulation (real
#           order mechanics against live prices, still zero real money).
#   live  - REAL MONEY. Also requires ALPACA_LIVE_TRADING_ACK below to be set
#           to the EXACT phrase alpaca_broker.py checks for - a bare "live"
#           here is not enough by itself, on purpose. See that module's
#           docstring before ever setting this: going live on a product
#           shipped to customers needs real compliance review, not just a
#           config change.
ALPACA_TRADING_MODE=off
ALPACA_LIVE_TRADING_ACK=

# --- Interactive Brokers (market data + order routing - control-api/app/ibkr_broker.py) ---
# UNLIKE Alpaca above, this is NOT a simple API-key integration: IBKR's
# Client Portal Web API is served by a locally-running Client Portal
# Gateway (a small Java process) that must already be started AND logged in
# (username/password + 2FA) before either the ibkr-feed provider or order
# routing below can do anything. IBKR_GATEWAY_BASE_URL just points at
# wherever that gateway is reachable - it does not start or authenticate it
# for you. Keeping the gateway alive/logged in (daily restarts, forced
# weekly re-auth) is a real ongoing task; IBeam (github.com/Voyz/ibeam) is
# the community-standard tool for automating it. Leave IBKR_TRADING_MODE=off
# (the default) to use neither.
IBKR_GATEWAY_BASE_URL=https://localhost:5000/v1/api
IBKR_GATEWAY_VERIFY_SSL=false
IBKR_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA

# Order routing mode: off (default) | paper | live - same two-signal safety
# pattern as ALPACA_TRADING_MODE above (live needs IBKR_LIVE_TRADING_ACK set
# to the exact phrase ibkr_broker.py checks for). One extra wrinkle unique
# to IBKR: "paper" here is also cross-checked against which account the
# gateway is actually logged into (IBKR paper account IDs start with "DU")
# - a mismatch refuses every order rather than trading the wrong book. See
# ibkr_broker.py's module docstring before setting this to anything but
# "off". Configuring BOTH this and ALPACA_TRADING_MODE to a non-off value
# at the same time is treated as a misconfiguration and refuses all orders.
IBKR_TRADING_MODE=off
IBKR_LIVE_TRADING_ACK=

# SECRET - set at deploy time, do NOT commit a real value. The installer reads
# this from the environment at run time and never stores/logs it. If a token is
# ever exposed (e.g. pasted somewhere), rotate it in the KX portal.
KX_BEARER_TOKEN=MDAwMSBhKnMxSlNSVXM-Mmo5aSREdEFSPk91KmIjP1J-PDdeaj1jVzMwQE5oIKkDcxAAAAA1w-Yp_UFArbyjrIctuYb8qQTaBnNoYTI1NvMgAAAAs5gFRpDy9JdHtOVACFpgJ8a7PRF13mXvCGUlCNUgKBPzEAAAAFyZQJxxBDe4IGxiEImekezpwCcJAOkBAAAA

# Base64-encoded KX license payload, consumed directly by q at runtime - the
# recommended path, nothing to mount anywhere. Also a secret - never commit
# the real value. Generate with: base64 -i kc.lic
KDB_LICENSE_B64=
# Alternative to KDB_LICENSE_B64 above: path to a license file mounted some
# other way (a Kubernetes Secret, a secrets-manager sidecar) - leave BLANK
# if using KDB_LICENSE_B64 (kdb-entrypoint.sh unsets this when
# KDB_LICENSE_B64 is set, but only because it's blank by default here - a
# leftover non-blank value pointing at a path that doesn't exist in this
# container will still be preferred by q itself and break license loading
# even with a valid KDB_LICENSE_B64 also set). Also a secret - never commit
# the real value.
KX_LICENSE_PATH=

# --- Natural-language-to-q query generation (control-api/app/nl2q.py) ---
# Defaults to an open-weights model served by the `ollama` compose service
# (docker-compose.yml) - no API key, no external network calls, works on
# an air-gapped box. Grounded in this TickHouse's live schema + q syntax
# via the system prompt in nl2q.py. First boot, pull the model once:
#   docker exec <ollama container name> ollama pull qwen2.5-coder:3b
# Bump to qwen2.5-coder:7b/:32b on a beefier or GPU host for materially
# better generation (pull that tag instead, and update NL2Q_LLM_MODEL).
NL2Q_LLM_PROVIDER=openai_compatible
NL2Q_LLM_MODEL=qwen2.5-coder:3b
# Required for "anthropic" (an Anthropic API key) or a hosted
# "openai_compatible" provider (that provider's API key) - leave blank for
# a local server that doesn't require one, like the bare Ollama instance
# above.
NL2Q_LLM_API_KEY=
# Only for "openai_compatible": point this at any OpenAI-shaped
# /chat/completions endpoint - OpenAI, Azure OpenAI, or a self-hosted model
# server (Ollama, vLLM, LM Studio) for on-prem/air-gapped deployments that
# can't call out to a public API at all. Set NL2Q_LLM_PROVIDER=anthropic
# (+ NL2Q_LLM_API_KEY, and drop this) to use Claude instead.
NL2Q_LLM_BASE_URL=http://ollama:11434/v1
# Local CPU inference is slower than a hosted API - give it more room than
# the 20s default before the UI falls back to the offline regex generator.
NL2Q_LLM_TIMEOUT_SEC=60

# --- Background query export to cloud storage (control-api/app/export_jobs.py,
# app/export_sinks.py) - the Query workspace's "Export to S3/ADLS" path for
# pulls too large for the local Parquet download (capped at 10GB - see
# app/parquet_export.py). Destination bucket/key or container/path is chosen
# per export in the UI; everything below is only ever credentials/defaults,
# never entered in the UI itself.
# S3: credentials come from the standard boto3 chain (env AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN, an attached IAM role, or
# ~/.aws/credentials) - nothing S3-specific to set here beyond an optional
# default bucket/region.
S3_BUCKET=
S3_REGION=
# ADLS: either a connection string (simplest) or an account URL + ambient
# Azure credentials (DefaultAzureCredential - managed identity / az login /
# service-principal env vars) if no connection string is set.
AZURE_STORAGE_CONNECTION_STRING=
ADLS_ACCOUNT_URL=
ADLS_CONTAINER=
# Row ceiling for the background export path only - independent of, and much
# higher than, the interactive query workspace's per-query cap.
EXPORT_BULK_ROW_LIMIT_MAX=5000000
# Gateway-pressure thresholds checked before a bulk export runs (flags the
# job in the UI with a pointer to the Autoscaling page; never triggers a
# scaling action by itself - see export_jobs.py).
EXPORT_GATEWAY_PRESSURE_QUEUE_THRESHOLD=200000
EXPORT_GATEWAY_PRESSURE_LAG_THRESHOLD=1000

# --- HTTPS edge (deploy/tls) ---
# Public domain served over HTTPS by Caddy. DNS A record must point here,
# ports 80+443 open. Caddy auto-provisions a Let's Encrypt cert.
TLS_DOMAIN=vantik.yourcompany.com
ACME_EMAIL=admin@yourcompany.com
# Must be the HTTPS URL in production — drives SSO redirects, absolute links,
# and Secure cookies.
PUBLIC_BASE_URL=https://vantik.yourcompany.com

