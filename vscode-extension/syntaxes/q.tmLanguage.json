{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "q",
  "scopeName": "source.q",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#symbol" },
    { "include": "#namespaced" },
    { "include": "#number" },
    { "include": "#keyword" },
    { "include": "#builtin" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "comment": "q comments only start a line (this grammar does not attempt trailing '/' comments, which are ambiguous with divide without full parsing)",
      "match": "^\\s*/.*$",
      "name": "comment.line.q"
    },
    "string": {
      "match": "\"(\\\\.|[^\"\\\\])*\"",
      "name": "string.quoted.double.q"
    },
    "symbol": {
      "comment": "a q symbol: ` alone, or ` followed by name/path segments",
      "match": "`(:[^\\s()\\[\\]{};,]*|[A-Za-z0-9_.][A-Za-z0-9_./]*)?",
      "name": "constant.other.symbol.q"
    },
    "namespaced": {
      "comment": ".z.p, .Q.dpft, .rdb.shard, ... - dot-namespaced identifiers",
      "match": "\\.[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+",
      "name": "entity.name.namespace.q"
    },
    "number": {
      "comment": "ints/floats with q type suffixes (0N/0W/1b/2h/3i/4j/5e/6f), and date/time/timestamp literals",
      "match": "-?\\b\\d{4}\\.\\d{2}\\.\\d{2}([DT]\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?)?|-?\\b\\d{2}:\\d{2}(:\\d{2}(\\.\\d+)?)?\\b|-?0[NW][bhijefmdznuvtc]?\\b|-?\\b\\d+\\.\\d+([ef])?\\b|-?\\b\\d+[bhijefmdznuvtc]?\\b",
      "name": "constant.numeric.q"
    },
    "keyword": {
      "match": "\\b(select|from|where|by|update|delete|exec|insert|upsert|if|do|while|exit)\\b",
      "name": "keyword.control.q"
    },
    "builtin": {
      "match": "\\b(abs|acos|asin|atan|avg|avgs|ceiling|cos|cor|cov|scov|deltas|dev|sdev|svar|var|div|mod|ema|exp|floor|log|max|maxs|mavg|mcount|mdev|med|min|mins|mmax|mmin|mmu|msum|neg|prd|prds|rand|ratios|reciprocal|signum|sin|sqrt|sum|sums|tan|wavg|wsum|xexp|xlog|all|and|any|not|or|within|like|in|null|asc|desc|iasc|idesc|distinct|group|rank|xrank|bin|binr|except|inter|union|cross|aj|aj0|ajf|ajf0|asof|ej|fby|ij|ijf|lj|ljf|pj|uj|ujf|wj|wj1|xgroup|xkey|xcol|xcols|xasc|xdesc|xbar|xprev|cols|keys|key|fkeys|meta|ungroup|flip|enlist|raze|cut|sublist|first|last|next|prev|reverse|rotate|differ|fills|til|count|tables|view|views|lower|upper|ltrim|rtrim|trim|string|ss|ssr|sv|vs|csv|parse|md5|type|boolean|byte|short|int|long|real|float|char|symbol|timestamp|month|date|datetime|timespan|minute|second|time|get|set|show|value|getenv|setenv|system|gc|read0|read1|hopen|hclose|hcount|hdel|hsym|load|rload|save|rsave|dsave|each|over|scan|peach|prior|eval)\\b",
      "name": "support.function.q"
    },
    "operator": {
      "match": "[:+\\-*%!?@.,<>=~|&#^$]",
      "name": "keyword.operator.q"
    }
  }
}
