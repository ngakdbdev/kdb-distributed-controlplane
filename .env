# Copy this file to .env and fill in real values before deploying anywhere
# beyond your own laptop. Nothing in this file should ever be committed
# with real secrets in it.

ADMIN_USER=admin
# Generate with: python3 -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
# Leave blank to fall back to the built-in default (password: changeme) - fine
# for a local demo, NOT fine for anything reachable from the internet.
ADMIN_PASSWORD_HASH=

JWT_SECRET=change-me-to-a-random-64-char-string
WATCHDOG_SHARED_SECRET=change-me-to-a-different-random-string

# --- Product licensing (control-api/app/licensing.py) ---
# This box is this session's own demo/dev deployment, not a real customer -
# stays "local" (unenforced). See .env.example's fuller comment.
DEPLOYMENT_ENV=local
LICENSE_KEY=
LICENSE_ENFORCE=

# ticks/sec and records/sec the feed simulators generate when enabled
BPIPE_RATE_HZ=25000
CRIMS_RATE_HZ=2

# --- KX (KDB-X) install: pulling the q binary + licence ---------------------
# Non-secret defaults for the portal download flow (fleet_agent/kx_installer.py):
# Docker precedence: the kdb containers use a binary already staged in the data
# folder (KX_BINARIES_DIR) if present; otherwise, when KX_INSTALL_SOURCE=kx-portal
# and KX_BEARER_TOKEN is set, they pull <arch>.zip from the KX portal into a cache.
# So attached binaries always win; the portal is the fallback.
KX_INSTALL_SOURCE=kx-portal      # kx-portal | local | url
KX_VERSION=4.1
KX_CHANNEL=~latest~
# Leave empty to auto-detect Linux container architecture (l64/l64arm).
KX_ARCH=
KX_INSTALL_DIR=/opt/kx
# 'local' source / docker: host folder of KX binaries (QHOME layout with
# per-arch subdirs l64/, l64arm/ + kc.lic). Mounted read-only into the kdb
# containers; the container picks the binary for its platform at start.
KX_BINARIES_DIR=./data-plane/docker/kdbx
SIM_SYMBOL_COUNT=1000
PROVIDER_SYMBOLS_FILE=/symbols/universe.txt
FINNHUB_API_KEY=d9ovvl9r01qh40a78g7gd9ovvl9r01qh40a78g80
# FX (OANDA:xxx_yyy is Finnhub's documented forex symbol format) alongside
# the existing US equities - forex trades ~24/5, unlike US equities, so
# this is real diversity that isn't gated behind the 9:30am ET open.
FINNHUB_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA,OANDA:EUR_USD,OANDA:GBP_USD,OANDA:USD_JPY

TWELVEDATA_API_KEY=92524bd2f42f4404bda3eaa423b7e923
# US equities + genuine cross-asset-class additions: FX pairs, XAU/XAG
# (gold/silver spot - the closest real commodity-adjacent data any
# currently-configured provider actually offers; no provider here has real
# agricultural/energy futures), and two NSE (India) large-caps for a real
# non-US equity market on a different trading-hours calendar. Twelve Data's
# own coverage note says international exchanges are plan-dependent - if
# the NSE names come back empty/rejected, that's the free plan's limit, not
# a bug; the FX/XAU/XAG symbols don't have that restriction.
TWELVEDATA_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA,EUR/USD,GBP/USD,USD/JPY,XAU/USD,XAG/USD,RELIANCE:NSE,TCS:NSE

# optional, blank = Predictive Signals news feed runs on Finnhub's own
# keyword sentiment heuristic instead of Alpha Vantage's real NLP scores
ALPHAVANTAGE_API_KEY=

# Alpaca (market data + order routing) - blank/off = unchanged behavior, the
# bot/order ticket keep using the internal simulated paper fill. See
# .env.example's own Alpaca block and control-api/app/alpaca_broker.py for
# the full safety model before setting ALPACA_TRADING_MODE to anything else.
ALPACA_API_KEY_ID=PKMKI4OMRJRYN3KTC5K3S4IYQE
ALPACA_API_SECRET_KEY=E2yn7pUYR5GzXGhdboYhmDfUrjxCxtvwy7Ukkrxud7Wj
ALPACA_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,JPM,V,UNH,HD,DIS,XOM,KO,WMT,PFE,CSCO,CRM,NFLX,AMD,IBM,BA,MCD,VZ,GS,WFC,GILD,SPY,QQQ,IWM
ALPACA_DATA_FEED=iex
ALPACA_TRADING_MODE=paper
ALPACA_LIVE_TRADING_ACK=

# Interactive Brokers - off (no gateway running on this box) - see
# .env.example's own IBKR block and control-api/app/ibkr_broker.py before
# setting IBKR_TRADING_MODE to anything else. Leaving both this and Alpaca
# non-off at once is refused as a misconfiguration - see trading.py's _router().
IBKR_GATEWAY_BASE_URL=https://localhost:5000/v1/api
IBKR_GATEWAY_VERIFY_SSL=false
IBKR_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA
IBKR_TRADING_MODE=off
IBKR_LIVE_TRADING_ACK=

# Kraken live provider (data-plane/feeds/providers/kraken.py) - public trade
# feed, no key needed. "all" subscribes to every currently-tradable pair
# Kraken lists (fetch_all_symbols() - a real REST call to Kraken's own
# instrument list, ~1,400 pairs at time of writing), not a hardcoded guess.
# Real trade PRINTS are still bounded by actual market activity per pair,
# not a configurable rate - "all" maximizes genuine throughput by maximizing
# real symbol coverage, which is the only honest lever available.
KRAKEN_SYMBOLS=all

# Coinbase, Binance, Bybit, OKX - same "all" convention as Kraken above: each
# provider's own fetch_all_symbols() pulls that venue's REAL current
# instrument list via its public REST API, no hardcoded guess. Binance in
# particular needs this: it's the highest-volume free exchange by far
# (~1,400 pairs), and its provider (providers/binance.py) shards the full
# list across multiple websocket connections automatically since one
# connection caps out at 1024 streams.
COINBASE_SYMBOLS=all
BINANCE_SYMBOLS=all
BYBIT_SYMBOLS=all
OKX_SYMBOLS=all
# SECRET - set at deploy time, do NOT commit a real value. The installer reads
# this from the environment at run time and never stores/logs it. If a token is
# ever exposed (e.g. pasted somewhere), rotate it in the KX portal.
KX_BEARER_TOKEN=MDAwMSBhKnMxSlNSVXM-Mmo5aSREdEFSPk91KmIjP1J-PDdeaj1jVzMwQE5oIKkDcxAAAAA1w-Yp_UFArbyjrIctuYb8qQTaBnNoYTI1NvMgAAAAs5gFRpDy9JdHtOVACFpgJ8a7PRF13mXvCGUlCNUgKBPzEAAAAFyZQJxxBDe4IGxiEImekezpwCcJAOkBAAAA

# Path to your KX licence file (kc.lic), mounted as a secret on the box.
# Also a secret - never commit the licence itself.
KX_LICENSE_PATH=
# Optional: base64 KX license payload consumed directly by q at runtime.
# This can be used when file-based license loading is unreliable in containers.
KDB_LICENSE_

# --- Natural-language-to-q query generation (control-api/app/nl2q.py) ---
# Open-weights model, self-hosted in the `ollama` compose service - no API
# key, no external calls, works on an air-gapped box. Grounded in this
# TickHouse's live schema + q syntax via the system prompt in nl2q.py.
# 3b keeps the footprint sane on this box's shared ~8GB Docker VM (there
# are a dozen other containers running); bump to qwen2.5-coder:7b or :32b
# on a beefier/GPU host for materially better generation (pull that tag
# into the ollama container first: docker exec <ollama container> ollama
# pull <tag>). Set NL2Q_LLM_PROVIDER=anthropic (+ NL2Q_LLM_API_KEY) instead
# if you'd rather use Claude.
NL2Q_LLM_PROVIDER=openai_compatible
NL2Q_LLM_MODEL=qwen2.5-coder:3b
NL2Q_LLM_API_KEY=
NL2Q_LLM_BASE_URL=http://ollama:11434/v1
NL2Q_LLM_TIMEOUT_SEC=60

# --- HTTPS edge (deploy/tls) ---
# Public domain served over HTTPS by Caddy. Currently pointed at
# vantik.qbytecomputing.com via a local /etc/hosts entry (127.0.0.1) for
# local HTTPS testing with a self-signed cert - see deploy/tls/README.md's
# "Local HTTPS testing" section. For a REAL public deployment this needs an
# actual DNS A record instead of a hosts-file entry, and the
# docker-compose.tls.yml overlay (Let's Encrypt) instead of local-tls.
TLS_DOMAIN=vantik.qbytecomputing.com
ACME_EMAIL=admin@qbytecomputing.com
# Must be the HTTPS URL in production — drives SSO redirects, absolute links,
# and Secure cookies.
PUBLIC_BASE_URL=https://vantik.qbytecomputing.com

# --- Query cost governance (control-api/app/query_cost.py) ---
# 0 (default) = no budget enforced. Set to enable per-tenant throttling on
# the query workspace - see /query/cost/summary for live consumption.
QUERY_BUDGET_MS_PER_WINDOW=0
QUERY_BUDGET_WINDOW_HOURS=1
